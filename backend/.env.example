# ── LLM API Keys ──────────────────────────────────────────
# Google Gemini (free): https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Anthropic Claude (paid): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── AWS Credentials (for Bedrock Titan V2 embeddings) ─────
# IAM user needs: AmazonBedrockFullAccess policy
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# ── Server ────────────────────────────────────────────────
PORT=3000
